{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Managed from pacphi/mise-dotfiles. Replaces Dependabot version updates (2026-10-21).",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "github-actions: settings",
      "matchCategories": [
        "ci"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ]
    },
    {
      "description": "github-actions: group github-actions",
      "matchCategories": [
        "ci"
      ],
      "groupName": "github-actions",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "npm: settings",
      "matchCategories": [
        "js"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ]
    },
    {
      "description": "npm: group node-runtime",
      "matchCategories": [
        "js"
      ],
      "groupName": "node-runtime",
      "matchPackageNames": [
        "*"
      ],
      "matchDepTypes": [
        "dependencies"
      ]
    },
    {
      "description": "npm: group node-dev",
      "matchCategories": [
        "js"
      ],
      "groupName": "node-dev",
      "matchPackageNames": [
        "*"
      ],
      "matchDepTypes": [
        "devDependencies"
      ]
    },
    {
      "description": "cargo cogs/battleship/**: settings",
      "matchCategories": [
        "rust"
      ],
      "matchFileNames": [
        "cogs/battleship/**"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ]
    },
    {
      "description": "cargo cogs/battleship/**: group cargo-deps",
      "matchCategories": [
        "rust"
      ],
      "matchFileNames": [
        "cogs/battleship/**"
      ],
      "groupName": "cargo-deps",
      "matchPackageNames": [
        "*"
      ]
    }
  ]
}
