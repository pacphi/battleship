#Requires -Version 5.1

param(
    [ValidateSet("doctor", "install", "uninstall", "run")]
    [string]$Command = "doctor",

    [ValidateSet("", "zrok", "ngrok")]
    [string]$Provider = "",

    [ValidateSet("project", "user")]
    [string]$Scope = "project",

    [string]$Version = "2.0.4",

    [int]$Port = 4321
)

$ErrorActionPreference = "Stop"
$ScriptPath = if ($PSCommandPath) { $PSCommandPath } elseif ($MyInvocation.MyCommand.Path) { $MyInvocation.MyCommand.Path } else { "" }
$ScriptDir = if ($ScriptPath) { Split-Path -Parent $ScriptPath } elseif ($PSScriptRoot) { $PSScriptRoot } else { Get-Location }
$CandidateRoot = Resolve-Path $ScriptDir
if ((Test-Path (Join-Path $CandidateRoot "package.json")) -and (Test-Path (Join-Path $CandidateRoot "scripts/tunnel-setup.pwsh"))) {
    $RootDir = $CandidateRoot
} else {
    $RootDir = Resolve-Path (Join-Path $CandidateRoot "..")
}

function Write-Ok { param([string]$Message) Write-Host "OK  $Message" -ForegroundColor Green }
function Write-Warn { param([string]$Message) Write-Host "WARN $Message" -ForegroundColor Yellow }
function Write-Info { param([string]$Message) Write-Host "INFO $Message" -ForegroundColor Cyan }
function Write-Err { param([string]$Message) Write-Host "ERR $Message" -ForegroundColor Red }

function Test-Cmd {
    param([string]$Name)
    return $null -ne (Get-Command $Name -ErrorAction SilentlyContinue)
}

function Confirm-Action {
    param([string]$Prompt)
    $answer = Read-Host "$Prompt [y/N]"
    return $answer -match "^(y|yes)$"
}

function Get-Paths {
    param(
        [string]$Tool,
        [string]$InstallScope,
        [string]$ToolVersion
    )

    if ($InstallScope -eq "project") {
        $installRoot = Join-Path $RootDir ".tools\$Tool"
        $binDir = Join-Path $RootDir ".tools\bin"
        $manifestDir = Join-Path $RootDir ".tools\manifests"
    } else {
        $installRoot = Join-Path $env:LOCALAPPDATA "Programs\battleship-tools\$Tool"
        $binDir = Join-Path $env:LOCALAPPDATA "Programs\battleship-tools\bin"
        $manifestDir = Join-Path $env:LOCALAPPDATA "Programs\battleship-tools\manifests"
    }

    return [pscustomobject]@{
        InstallRoot = $installRoot
        InstallDir = Join-Path $installRoot $ToolVersion
        BinDir = $binDir
        ManifestDir = $manifestDir
        ManifestPath = Join-Path $manifestDir "$Tool-$InstallScope.json"
    }
}

function Get-ZrokAssetPlatform {
    $arch = $env:PROCESSOR_ARCHITECTURE
    switch ($arch) {
        "AMD64" { return [pscustomobject]@{ Platform = "windows_amd64"; Compatibility = $false } }
        "ARM64" {
            Write-Warn "zrok does not currently publish a Windows ARM64 artifact; using Windows x64 under emulation."
            return [pscustomobject]@{ Platform = "windows_amd64"; Compatibility = $true }
        }
        default { throw "Unsupported Windows architecture: $arch" }
    }
}

function Invoke-Download {
    param([string]$Uri, [string]$OutFile)
    Invoke-WebRequest -Uri $Uri -OutFile $OutFile -UseBasicParsing
}

function Install-Zrok {
    param([string]$InstallScope, [string]$ToolVersion)

    $platformInfo = Get-ZrokAssetPlatform
    $asset = "zrok_$($ToolVersion)_$($platformInfo.Platform).tar.gz"
    $baseUrl = "https://github.com/openziti/zrok/releases/download/v$ToolVersion"
    $archiveUrl = "$baseUrl/$asset"
    $checksumUrl = "$baseUrl/checksums.sha256.txt"
    $paths = Get-Paths -Tool "zrok2" -InstallScope $InstallScope -ToolVersion $ToolVersion

    New-Item -ItemType Directory -Force -Path $paths.InstallDir, $paths.BinDir, $paths.ManifestDir | Out-Null
    $tmp = Join-Path ([System.IO.Path]::GetTempPath()) "battleship-zrok-$([guid]::NewGuid())"
    New-Item -ItemType Directory -Force -Path $tmp | Out-Null

    try {
        $archive = Join-Path $tmp $asset
        $checksums = Join-Path $tmp "checksums.sha256.txt"

        Write-Info "Downloading $asset"
        Invoke-Download -Uri $archiveUrl -OutFile $archive
        Invoke-Download -Uri $checksumUrl -OutFile $checksums

        $expectedLine = Get-Content $checksums | Where-Object { $_ -match "\s$([regex]::Escape($asset))$" } | Select-Object -First 1
        if (-not $expectedLine) {
            throw "Checksum file did not contain $asset"
        }
        $expected = ($expectedLine -split "\s+")[0].ToLowerInvariant()
        $actual = (Get-FileHash -Algorithm SHA256 -Path $archive).Hash.ToLowerInvariant()
        if ($expected -ne $actual) {
            throw "Checksum mismatch for $asset"
        }
        Write-Ok "Verified SHA-256 checksum"

        tar -xzf $archive -C $tmp
        $exe = Get-ChildItem -Path $tmp -Recurse -File -Filter "zrok2.exe" | Select-Object -First 1
        if (-not $exe) {
            throw "Archive did not contain zrok2.exe"
        }

        $binPath = Join-Path $paths.InstallDir "zrok2.exe"
        Copy-Item -Force $exe.FullName $binPath

        $shimPath = Join-Path $paths.BinDir "zrok2.cmd"
        "@echo off`r`n""$binPath"" %*`r`n" | Set-Content -Encoding ASCII -Path $shimPath

        $manifest = [ordered]@{
            tool = "zrok2"
            provider = "zrok"
            version = $ToolVersion
            asset = $asset
            scope = $InstallScope
            installDir = $paths.InstallDir
            binDir = $paths.BinDir
            binPath = $shimPath
            sha256 = $actual
            compatibilityMode = $platformInfo.Compatibility
        }
        $manifest | ConvertTo-Json | Set-Content -Encoding UTF8 -Path $paths.ManifestPath

        Write-Ok "Installed zrok2 $ToolVersion at $binPath"
        if (($env:Path -split ";") -notcontains $paths.BinDir) {
            Write-Warn "$($paths.BinDir) is not on PATH."
        }
    } finally {
        Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue
    }
}

function Uninstall-Zrok {
    param([string]$InstallScope, [string]$ToolVersion)

    $paths = Get-Paths -Tool "zrok2" -InstallScope $InstallScope -ToolVersion $ToolVersion
    if (-not (Test-Path $paths.ManifestPath)) {
        Write-Warn "No manifest found at $($paths.ManifestPath)"
        return
    }

    $manifest = Get-Content $paths.ManifestPath | ConvertFrom-Json
    if (-not $manifest.installDir.StartsWith($paths.InstallRoot)) {
        throw "Refusing to remove unmanaged install dir: $($manifest.installDir)"
    }

    Remove-Item -Force $manifest.binPath -ErrorAction SilentlyContinue
    Remove-Item -Recurse -Force $manifest.installDir -ErrorAction SilentlyContinue
    Remove-Item -Force $paths.ManifestPath
    Write-Ok "Uninstalled managed zrok2 ($InstallScope)"
}

function Install-Ngrok {
    param([string]$InstallScope)

    if ($InstallScope -ne "user") {
        throw "ngrok project-local installs are not managed. Use -Scope user or install from https://ngrok.com/download/windows."
    }

    if (Test-Cmd winget) {
        winget install --id Ngrok.ngrok --accept-source-agreements --accept-package-agreements
    } elseif (Test-Cmd scoop) {
        scoop install extras/ngrok
    } else {
        throw "No supported ngrok installer found. Install from https://ngrok.com/download/windows."
    }
    Write-Ok "ngrok is installed"
}

function Uninstall-Ngrok {
    if (Test-Cmd winget) {
        if (Confirm-Action "Remove ngrok with winget?") {
            winget uninstall --id Ngrok.ngrok
            return
        }
    }
    if (Test-Cmd scoop) {
        if (Confirm-Action "Remove ngrok with scoop?") {
            scoop uninstall ngrok
            return
        }
    }
    Write-Warn "No managed ngrok package was removed."
}

function Get-ProviderTool {
    param([string]$TunnelProvider)

    if ($TunnelProvider -eq "zrok") {
        $local = Join-Path $RootDir ".tools\bin\zrok2.cmd"
        if (Test-Path $local) { return $local }
        $cmd = Get-Command zrok2 -ErrorAction SilentlyContinue
        if ($cmd) { return $cmd.Source }
    }

    if ($TunnelProvider -eq "ngrok") {
        $cmd = Get-Command ngrok -ErrorAction SilentlyContinue
        if ($cmd) { return $cmd.Source }
    }

    throw "$TunnelProvider CLI not found."
}

function Ensure-Build {
    Push-Location $RootDir
    try {
        if (-not (Test-Path "dist")) {
            Write-Info "Building static site"
            pnpm build
        }
    } finally {
        Pop-Location
    }
}

function Run-Provider {
    param([string]$TunnelProvider, [int]$LocalPort)

    $tool = Get-ProviderTool -TunnelProvider $TunnelProvider
    Ensure-Build

    Push-Location $RootDir
    try {
        Write-Info "Starting single-origin Battleship server on http://localhost:$LocalPort"
        $server = Start-Process pwsh -ArgumentList "-NoProfile", "-Command", "`$env:PORT=$LocalPort; pnpm server" -NoNewWindow -PassThru
        Start-Sleep -Seconds 2

        try {
            if ($TunnelProvider -eq "zrok") {
                & $tool share public $LocalPort
            } else {
                & $tool http $LocalPort
            }
        } finally {
            Stop-Process -Id $server.Id -ErrorAction SilentlyContinue
        }
    } finally {
        Pop-Location
    }
}

function Invoke-Doctor {
    Write-Info "Node: $(try { node --version } catch { 'missing' })"
    Write-Info "pnpm: $(try { (Get-Command pnpm -ErrorAction Stop).Source } catch { 'missing' })"
    Write-Info "zrok2: $(try { Get-ProviderTool zrok } catch { 'missing' })"
    Write-Info "ngrok: $(try { (Get-Command ngrok -ErrorAction Stop).Source } catch { 'missing' })"
}

switch ($Command) {
    "doctor" {
        Invoke-Doctor
    }
    "install" {
        if ($Provider -eq "zrok") { Install-Zrok -InstallScope $Scope -ToolVersion $Version }
        elseif ($Provider -eq "ngrok") { Install-Ngrok -InstallScope $Scope }
        else { throw "install requires Provider zrok or ngrok" }
    }
    "uninstall" {
        if ($Provider -eq "zrok") { Uninstall-Zrok -InstallScope $Scope -ToolVersion $Version }
        elseif ($Provider -eq "ngrok") { Uninstall-Ngrok }
        else { throw "uninstall requires Provider zrok or ngrok" }
    }
    "run" {
        if ($Provider -ne "zrok" -and $Provider -ne "ngrok") { throw "run requires Provider zrok or ngrok" }
        Run-Provider -TunnelProvider $Provider -LocalPort $Port
    }
}
