#Requires -Version 5.1

param(
    [ValidateSet("setup", "doctor", "install", "uninstall", "run")]
    [string]$Command = "doctor",

    [ValidateSet("", "zrok", "ngrok")]
    [string]$Provider = "",

    [ValidateSet("project", "user")]
    [string]$Scope = "project",

    [string]$Version = "2.0.4",

    [int]$Port = 4321,

    [switch]$Yes,
    [switch]$AssumeYes
)

$ErrorActionPreference = "Stop"
$ScriptPath = if ($PSCommandPath) { $PSCommandPath } elseif ($MyInvocation.MyCommand.Path) { $MyInvocation.MyCommand.Path } else { "" }
$ScriptDir = if ($ScriptPath) { Split-Path -Parent $ScriptPath } elseif ($PSScriptRoot) { $PSScriptRoot } else { Get-Location }
$CandidateRoot = Resolve-Path $ScriptDir
if ((Test-Path (Join-Path $CandidateRoot "package.json")) -and (Test-Path (Join-Path $CandidateRoot "scripts/tunnel-setup.pwsh"))) {
    $RootDir = $CandidateRoot
} else {
    $RootDir = Resolve-Path (Join-Path $CandidateRoot "..")
}

function Write-Ok { param([string]$Message) Write-Host "OK  $Message" -ForegroundColor Green }
function Write-Warn { param([string]$Message) Write-Host "WARN $Message" -ForegroundColor Yellow }
function Write-Info { param([string]$Message) Write-Host "INFO $Message" -ForegroundColor Cyan }
function Write-Err { param([string]$Message) Write-Host "ERR $Message" -ForegroundColor Red }

function Test-Cmd {
    param([string]$Name)
    return $null -ne (Get-Command $Name -ErrorAction SilentlyContinue)
}

function Confirm-Action {
    param([string]$Prompt)
    if ($script:Yes -or $script:AssumeYes) {
        Write-Info "$Prompt (auto-confirmed)"
        return $true
    }
    $answer = Read-Host "$Prompt [y/N]"
    return $answer -match "^(y|yes)$"
}

function Test-PortInUse {
    param([int]$TargetPort)
    try {
        $client = [System.Net.Sockets.TcpClient]::new()
        $async = $client.BeginConnect("127.0.0.1", $TargetPort, $null, $null)
        $connected = $async.AsyncWaitHandle.WaitOne(300) -and $client.Connected
        $client.Close()
        return $connected
    } catch {
        return $false
    }
}

# Returns $null when zrok is not installed, $true when enabled, $false otherwise.
function Test-ZrokEnabled {
    $tool = $null
    try { $tool = Get-ProviderTool zrok } catch { return $null }
    $out = (& $tool status 2>&1 | Out-String)
    if ($out -match "(?i)enable command") { return $false }
    return $true
}

# Returns $null when ngrok is not installed, $true when an authtoken is found, $false otherwise.
function Test-NgrokAuthed {
    if (-not (Test-Cmd ngrok)) { return $null }
    $out = (& ngrok config check 2>&1 | Out-String)
    $candidates = @()
    if ($out -match "(?im)\bat\s+(.+)$") { $candidates += $Matches[1].Trim() }
    $candidates += (Join-Path $env:LOCALAPPDATA "ngrok\ngrok.yml")
    $candidates += (Join-Path $env:USERPROFILE ".ngrok2\ngrok.yml")
    foreach ($f in $candidates) {
        if ($f -and (Test-Path $f) -and (Select-String -Path $f -Pattern "authtoken" -Quiet -ErrorAction SilentlyContinue)) {
            return $true
        }
    }
    return $false
}

function Invoke-Preflight {
    param([string]$TunnelProvider)
    if ($TunnelProvider -eq "zrok") {
        if ((Test-ZrokEnabled) -eq $false) {
            Write-Err "zrok is installed, but your environment isn't enabled yet."
            Write-Info "Enable it once with a free token:"
            Write-Info "  1. Sign up at https://zrok.io - the web console shows your token and enable command"
            Write-Info "  2. Run: .\.tools\bin\zrok2.cmd enable <your-token>"
            Write-Info "Or run the guided setup: .\scripts\tunnel-setup.pwsh setup"
            throw "zrok environment not enabled"
        }
    } elseif ($TunnelProvider -eq "ngrok") {
        if ((Test-NgrokAuthed) -eq $false) {
            Write-Warn "Couldn't confirm an ngrok authtoken. If the tunnel fails to start:"
            Write-Info "  1. Sign up at https://dashboard.ngrok.com/signup"
            Write-Info "  2. Copy your token: https://dashboard.ngrok.com/get-started/your-authtoken"
            Write-Info "  3. Run: ngrok config add-authtoken <your-token>"
        }
    }
}

function Select-Provider {
    if ($script:Yes -or $script:AssumeYes) { return "zrok" }
    Write-Host ""
    Write-Host "Which tunnel do you want to use?" -ForegroundColor White
    Write-Host "  1) zrok  - free, open-source, installs just for this project (recommended)"
    Write-Host "  2) ngrok - popular, installs on your whole computer"
    $ans = Read-Host "Choose 1 or 2 [1]"
    if ($ans -eq "2" -or $ans -eq "ngrok") { return "ngrok" }
    return "zrok"
}

function Get-Paths {
    param(
        [string]$Tool,
        [string]$InstallScope,
        [string]$ToolVersion
    )

    if ($InstallScope -eq "project") {
        $installRoot = Join-Path $RootDir ".tools\$Tool"
        $binDir = Join-Path $RootDir ".tools\bin"
        $manifestDir = Join-Path $RootDir ".tools\manifests"
    } else {
        $installRoot = Join-Path $env:LOCALAPPDATA "Programs\battleship-tools\$Tool"
        $binDir = Join-Path $env:LOCALAPPDATA "Programs\battleship-tools\bin"
        $manifestDir = Join-Path $env:LOCALAPPDATA "Programs\battleship-tools\manifests"
    }

    return [pscustomobject]@{
        InstallRoot = $installRoot
        InstallDir = Join-Path $installRoot $ToolVersion
        BinDir = $binDir
        ManifestDir = $manifestDir
        ManifestPath = Join-Path $manifestDir "$Tool-$InstallScope.json"
    }
}

function Get-ZrokAssetPlatform {
    $arch = $env:PROCESSOR_ARCHITECTURE
    switch ($arch) {
        "AMD64" { return [pscustomobject]@{ Platform = "windows_amd64"; Compatibility = $false } }
        "ARM64" {
            Write-Warn "zrok does not currently publish a Windows ARM64 artifact; using Windows x64 under emulation."
            return [pscustomobject]@{ Platform = "windows_amd64"; Compatibility = $true }
        }
        default { throw "Unsupported Windows architecture: $arch" }
    }
}

function Invoke-Download {
    param([string]$Uri, [string]$OutFile)
    Invoke-WebRequest -Uri $Uri -OutFile $OutFile -UseBasicParsing
}

function Install-Zrok {
    param([string]$InstallScope, [string]$ToolVersion)

    $platformInfo = Get-ZrokAssetPlatform
    $asset = "zrok_$($ToolVersion)_$($platformInfo.Platform).tar.gz"
    $baseUrl = "https://github.com/openziti/zrok/releases/download/v$ToolVersion"
    $archiveUrl = "$baseUrl/$asset"
    $checksumUrl = "$baseUrl/checksums.sha256.txt"
    $paths = Get-Paths -Tool "zrok2" -InstallScope $InstallScope -ToolVersion $ToolVersion

    New-Item -ItemType Directory -Force -Path $paths.InstallDir, $paths.BinDir, $paths.ManifestDir | Out-Null
    $tmp = Join-Path ([System.IO.Path]::GetTempPath()) "battleship-zrok-$([guid]::NewGuid())"
    New-Item -ItemType Directory -Force -Path $tmp | Out-Null

    try {
        $archive = Join-Path $tmp $asset
        $checksums = Join-Path $tmp "checksums.sha256.txt"

        Write-Info "Downloading $asset"
        Invoke-Download -Uri $archiveUrl -OutFile $archive
        Invoke-Download -Uri $checksumUrl -OutFile $checksums

        $expectedLine = Get-Content $checksums | Where-Object { $_ -match "\s$([regex]::Escape($asset))$" } | Select-Object -First 1
        if (-not $expectedLine) {
            throw "Checksum file did not contain $asset"
        }
        $expected = ($expectedLine -split "\s+")[0].ToLowerInvariant()
        $actual = (Get-FileHash -Algorithm SHA256 -Path $archive).Hash.ToLowerInvariant()
        if ($expected -ne $actual) {
            throw "Checksum mismatch for $asset"
        }
        Write-Ok "Verified SHA-256 checksum"

        tar -xzf $archive -C $tmp
        $exe = Get-ChildItem -Path $tmp -Recurse -File -Filter "zrok2.exe" | Select-Object -First 1
        if (-not $exe) {
            throw "Archive did not contain zrok2.exe"
        }

        $binPath = Join-Path $paths.InstallDir "zrok2.exe"
        Copy-Item -Force $exe.FullName $binPath

        $shimPath = Join-Path $paths.BinDir "zrok2.cmd"
        "@echo off`r`n""$binPath"" %*`r`n" | Set-Content -Encoding ASCII -Path $shimPath

        $manifest = [ordered]@{
            tool = "zrok2"
            provider = "zrok"
            version = $ToolVersion
            asset = $asset
            scope = $InstallScope
            installDir = $paths.InstallDir
            binDir = $paths.BinDir
            binPath = $shimPath
            sha256 = $actual
            compatibilityMode = $platformInfo.Compatibility
        }
        $manifest | ConvertTo-Json | Set-Content -Encoding UTF8 -Path $paths.ManifestPath

        Write-Ok "Installed zrok2 $ToolVersion at $binPath"
        if (($env:Path -split ";") -notcontains $paths.BinDir) {
            Write-Warn "$($paths.BinDir) is not on PATH."
        }
    } finally {
        Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue
    }
}

function Uninstall-Zrok {
    param([string]$InstallScope, [string]$ToolVersion)

    $paths = Get-Paths -Tool "zrok2" -InstallScope $InstallScope -ToolVersion $ToolVersion
    if (-not (Test-Path $paths.ManifestPath)) {
        Write-Warn "No manifest found at $($paths.ManifestPath)"
        return
    }

    $manifest = Get-Content $paths.ManifestPath | ConvertFrom-Json
    if (-not $manifest.installDir.StartsWith($paths.InstallRoot)) {
        throw "Refusing to remove unmanaged install dir: $($manifest.installDir)"
    }

    Remove-Item -Force $manifest.binPath -ErrorAction SilentlyContinue
    Remove-Item -Recurse -Force $manifest.installDir -ErrorAction SilentlyContinue
    Remove-Item -Force $paths.ManifestPath
    Write-Ok "Uninstalled managed zrok2 ($InstallScope)"
}

function Install-Ngrok {
    param([string]$InstallScope)

    if ($InstallScope -ne "user") {
        throw "ngrok project-local installs are not managed. Use -Scope user or install from https://ngrok.com/download/windows."
    }

    if (Test-Cmd winget) {
        winget install --id Ngrok.ngrok --accept-source-agreements --accept-package-agreements
    } elseif (Test-Cmd scoop) {
        scoop install extras/ngrok
    } else {
        throw "No supported ngrok installer found. Install from https://ngrok.com/download/windows."
    }
    Write-Ok "ngrok is installed"
}

function Uninstall-Ngrok {
    if (Test-Cmd winget) {
        if (Confirm-Action "Remove ngrok with winget?") {
            winget uninstall --id Ngrok.ngrok
            return
        }
    }
    if (Test-Cmd scoop) {
        if (Confirm-Action "Remove ngrok with scoop?") {
            scoop uninstall ngrok
            return
        }
    }
    Write-Warn "No managed ngrok package was removed."
}

function Get-ProviderTool {
    param([string]$TunnelProvider)

    if ($TunnelProvider -eq "zrok") {
        $local = Join-Path $RootDir ".tools\bin\zrok2.cmd"
        if (Test-Path $local) { return $local }
        $cmd = Get-Command zrok2 -ErrorAction SilentlyContinue
        if ($cmd) { return $cmd.Source }
    }

    if ($TunnelProvider -eq "ngrok") {
        $cmd = Get-Command ngrok -ErrorAction SilentlyContinue
        if ($cmd) { return $cmd.Source }
    }

    throw "$TunnelProvider CLI not found."
}

function Ensure-Build {
    Push-Location $RootDir
    try {
        if (-not (Test-Path "dist")) {
            Write-Info "Building static site"
            pnpm build
        }
    } finally {
        Pop-Location
    }
}

function Run-Provider {
    param([string]$TunnelProvider, [int]$LocalPort)

    $tool = Get-ProviderTool -TunnelProvider $TunnelProvider
    Invoke-Preflight -TunnelProvider $TunnelProvider
    if (Test-PortInUse $LocalPort) {
        Write-Warn "Port $LocalPort is already in use; the local server may fail to start."
    }
    Ensure-Build

    Push-Location $RootDir
    try {
        Write-Info "Starting single-origin Battleship server on http://localhost:$LocalPort"
        $server = Start-Process pwsh -ArgumentList "-NoProfile", "-Command", "`$env:PORT=$LocalPort; pnpm server" -NoNewWindow -PassThru
        Start-Sleep -Seconds 2

        try {
            if ($TunnelProvider -eq "zrok") {
                & $tool share public $LocalPort
            } else {
                & $tool http $LocalPort
            }
        } finally {
            Stop-Process -Id $server.Id -ErrorAction SilentlyContinue
        }
    } finally {
        Pop-Location
    }
}

function Invoke-Doctor {
    Write-Host "Battleship tunnel doctor" -ForegroundColor White
    Write-Host ""

    Write-Host "Core" -ForegroundColor White
    if (Test-Cmd node) { Write-Ok "Node $(node --version)" } else { Write-Err "Node missing - install Node >= 26" }
    if (Test-Cmd pnpm) { Write-Ok "pnpm $(pnpm --version) ($((Get-Command pnpm).Source))" } else { Write-Err "pnpm missing - run: corepack enable" }
    if (Test-Path (Join-Path $RootDir "dist")) { Write-Ok "Game is built (dist/ present)" } else { Write-Warn "Game not built yet - builds automatically on first run, or run: pnpm build" }
    if (Test-PortInUse $Port) { Write-Warn "Port $Port is busy - close the other server, or pass -Port <n>" } else { Write-Ok "Port $Port is free" }
    Write-Host ""

    Write-Host "zrok  (recommended - free, installs just for this project)" -ForegroundColor White
    $zEnabled = Test-ZrokEnabled
    if ($null -eq $zEnabled) {
        Write-Warn "Not installed - run: .\scripts\tunnel-setup.pwsh setup   (or: install zrok)"
    } elseif ($zEnabled) {
        Write-Ok "Installed and enabled - ready to host"
    } else {
        Write-Ok "Installed"
        Write-Warn "Not enabled yet - run: .\scripts\tunnel-setup.pwsh setup   (or: .\.tools\bin\zrok2.cmd enable <token>)"
    }
    Write-Host ""

    Write-Host "ngrok  (installs on your whole computer)" -ForegroundColor White
    $nAuth = Test-NgrokAuthed
    if ($null -eq $nAuth) {
        Write-Warn "Not installed - run: .\scripts\tunnel-setup.pwsh setup   (or: install ngrok)"
    } elseif ($nAuth) {
        Write-Ok "Installed with authtoken - ready to host"
    } else {
        Write-Ok "Installed"
        Write-Warn "No authtoken found - run: .\scripts\tunnel-setup.pwsh setup   (or: ngrok config add-authtoken <token>)"
    }
    Write-Host ""

    Write-Host "Next step" -ForegroundColor White
    Write-Info "New here?  .\scripts\tunnel-setup.pwsh setup  walks you through everything."
    Write-Info "Ready?     .\scripts\tunnel-setup.pwsh run zrok  starts your public link."
}

function Setup-Tunnel {
    param([string]$TunnelProvider)

    Write-Host "Battleship - host setup" -ForegroundColor White
    Write-Info "This gets you one public link to share so a friend can join your game."
    Write-Host ""

    if (-not $TunnelProvider) { $TunnelProvider = Select-Provider }
    Write-Info "Using $TunnelProvider."
    Write-Host ""

    # Step 1 - make sure the tool is installed
    $installed = $true
    try { Get-ProviderTool $TunnelProvider | Out-Null } catch { $installed = $false }
    if (-not $installed) {
        Write-Warn "$TunnelProvider isn't installed yet."
        if (Confirm-Action "Install $TunnelProvider now?") {
            if ($TunnelProvider -eq "zrok") { Install-Zrok -InstallScope "project" -ToolVersion $Version }
            else { Install-Ngrok -InstallScope "user" }
        } else {
            throw "Can't continue without $TunnelProvider. Re-run setup when you're ready."
        }
    } else {
        Write-Ok "$TunnelProvider is installed."
    }
    Write-Host ""

    # Step 2 - make sure it's signed in
    if ($TunnelProvider -eq "zrok") {
        if (Test-ZrokEnabled) {
            Write-Ok "Your zrok environment is already enabled."
        } else {
            Write-Warn "zrok needs a free account token - this is a one-time step."
            Write-Info "1. Sign up at https://zrok.io"
            Write-Info "2. The web console shows your token and the exact enable command"
            if ($script:Yes -or $script:AssumeYes) {
                Write-Warn "Non-interactive - skipping token entry. Run later: .\.tools\bin\zrok2.cmd enable <token>"
            } else {
                $token = Read-Host "Paste your zrok token (or press Enter to skip)"
                if ($token) { & (Get-ProviderTool zrok) enable $token } else { Write-Warn "Skipped." }
            }
        }
    } else {
        if (Test-NgrokAuthed) {
            Write-Ok "ngrok already has an authtoken."
        } else {
            Write-Warn "ngrok needs an authtoken - this is a one-time step."
            Write-Info "1. Sign up at https://dashboard.ngrok.com/signup"
            Write-Info "2. Copy your token: https://dashboard.ngrok.com/get-started/your-authtoken"
            if ($script:Yes -or $script:AssumeYes) {
                Write-Warn "Non-interactive - skipping token entry. Run later: ngrok config add-authtoken <token>"
            } else {
                $token = Read-Host "Paste your ngrok authtoken (or press Enter to skip)"
                if ($token) { & (Get-ProviderTool ngrok) config add-authtoken $token } else { Write-Warn "Skipped." }
            }
        }
    }
    Write-Host ""

    # Step 3 - make sure the game is built
    if (Test-Path (Join-Path $RootDir "dist")) {
        Write-Ok "Game is already built."
    } elseif (Confirm-Action "Build the game now (needed before hosting)?") {
        Push-Location $RootDir
        try { pnpm build } finally { Pop-Location }
    }
    Write-Host ""

    # Step 4 - recap and offer to launch
    Invoke-Doctor
    Write-Host ""
    if (Confirm-Action "Start hosting now (opens your public link)?") {
        Run-Provider -TunnelProvider $TunnelProvider -LocalPort $Port
    } else {
        Write-Info "When you're ready: .\scripts\tunnel-setup.pwsh run $TunnelProvider"
    }
}

switch ($Command) {
    "setup" {
        Setup-Tunnel -TunnelProvider $Provider
    }
    "doctor" {
        Invoke-Doctor
    }
    "install" {
        if ($Provider -eq "zrok") { Install-Zrok -InstallScope $Scope -ToolVersion $Version }
        elseif ($Provider -eq "ngrok") { Install-Ngrok -InstallScope $Scope }
        else { throw "install requires Provider zrok or ngrok" }
    }
    "uninstall" {
        if ($Provider -eq "zrok") { Uninstall-Zrok -InstallScope $Scope -ToolVersion $Version }
        elseif ($Provider -eq "ngrok") { Uninstall-Ngrok }
        else { throw "uninstall requires Provider zrok or ngrok" }
    }
    "run" {
        if ($Provider -ne "zrok" -and $Provider -ne "ngrok") { throw "run requires Provider zrok or ngrok" }
        Run-Provider -TunnelProvider $Provider -LocalPort $Port
    }
}
