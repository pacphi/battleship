{
  "name": "battleship-p2p",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.3",
  "approvedBuilds": [
    "esbuild",
    "sharp"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "server": "node server/index.mjs",
    "tunnel:setup": "scripts/tunnel-setup.sh setup",
    "tunnel:doctor": "scripts/tunnel-setup.sh doctor",
    "tunnel:install:zrok": "scripts/tunnel-setup.sh install zrok --scope project",
    "tunnel:uninstall:zrok": "scripts/tunnel-setup.sh uninstall zrok --scope project",
    "tunnel:install:ngrok": "scripts/tunnel-setup.sh install ngrok --scope user",
    "tunnel:uninstall:ngrok": "scripts/tunnel-setup.sh uninstall ngrok",
    "tunnel:zrok": "scripts/tunnel-setup.sh run zrok",
    "tunnel:ngrok": "scripts/tunnel-setup.sh run ngrok",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "deps:outdated": "pnpm outdated",
    "deps:update": "pnpm update",
    "deps:update:latest": "pnpm update --latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"*.{md,markdown}\" \"docs/**/*.{md,markdown}\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"*.{md,markdown}\" \"docs/**/*.{md,markdown}\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "fix": "pnpm run lint:fix && pnpm run format"
  },
  "dependencies": {
    "astro": "^7.1.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
