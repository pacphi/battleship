{
  "default": true,
  "MD013": false,
  "MD025": false,
  "MD041": false,
  "MD040": false,
  "MD033": {
    "allowed_elements": ["a", "img"]
  }, // allow <a><img></a> for clickable, width-controlled thumbnails (docs/SCREENSHOTS.md)
